{
  "name": "strum",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "format:check": "prettier --check 'src/**/*.{ts,svelte,css}' vite.config.ts svelte.config.js package.json tsconfig.json scripts/build.mjs scripts/benchmark.mjs scripts/check-migration-mutants.mjs",
    "check": "npm run format:check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test",
    "test:edge": "playwright test --config=playwright.edge.config.js",
    "test:mutations": "node scripts/check-migration-mutants.mjs",
    "verify": "npm run check && npm test && npm run test:browser && npm run test:edge",
    "icons": "node scripts/icons.mjs",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "dependencies": {
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "22.19.19",
    "prettier": "3.9.7",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "wrangler": "4.132.0"
  }
}
