/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/sw.js
  Cache-Control: no-store
/version.json
  Cache-Control: no-store
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
